# API Configuration
PROJECT_NAME="FastAPI Production Template"
SECRET_KEY="super-secret-key-change-in-production-1234567890!"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Initial Admin Seeding Configuration
FIRST_SUPERUSER_EMAIL="admin@example.com"
FIRST_SUPERUSER_PASSWORD="AdminPassword123!"

# Database Connections
# Development Defaults
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/app"
REDIS_URL="redis://localhost:6379/0"
RABBITMQ_URL="amqp://guest:guest@localhost:5672//"

# Email Credentials (SendGrid)
SENDGRID_API_KEY=""
SENDER_EMAIL="noreply@example.com"

# S3 File Storage Settings
# For AWS, remove S3_ENDPOINT_URL and use real keys.
# For local dev via docker-compose, keep S3_ENDPOINT_URL pointing to localstack.
AWS_ACCESS_KEY_ID="mock-key"
AWS_SECRET_ACCESS_KEY="mock-secret"
AWS_REGION="us-east-1"
S3_BUCKET_NAME="app-assets"
S3_ENDPOINT_URL="http://localhost:4566"

# Security & Logs Whitelisting
# Comma-separated list or JSON list format
ALLOWED_IPS="127.0.0.1, ::1"
SENSITIVE_KEYS="password, password_confirm, token, secret, access_token, authorization, api_key, x-api-key, credit_card"
